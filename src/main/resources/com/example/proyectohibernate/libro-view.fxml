<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/18"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="10"
      padding="20">


    <Label text="Registro de libros"/>


    <GridPane hgap="10" vgap="5">



        <Label text="Título:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField promptText="Título del libro" GridPane.rowIndex="0" GridPane.columnIndex="1"/>


        <Label text="Autor:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField promptText="Autor del libro" GridPane.rowIndex="1" GridPane.columnIndex="1"/>


        <Label text="Año:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField promptText="Año de publicación" GridPane.rowIndex="2" GridPane.columnIndex="1"/>


        <Label text="Price:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField promptText="Price del libro" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>


    <HBox spacing="10">
        <Button text="Guardar libro"/>
        <Button text="Cargar libros"/>
    </HBox>


    <TableView prefHeight="200">
        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>
        <columns>
            <TableColumn text="ID" prefWidth="60"/>
            <TableColumn text="Título" prefWidth="150"/>
            <TableColumn text="Autor" prefWidth="120"/>
            <TableColumn text="Año" prefWidth="80"/>
            <TableColumn text="Price" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>